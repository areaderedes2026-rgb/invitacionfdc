# =========================
# Admin (obligatorio en Vercel)
# =========================
ADMIN_USER=admin
ADMIN_PASSWORD=clave-larga-de-al-menos-12-caracteres
AUTH_SECRET=cadena-aleatoria-de-al-menos-32-caracteres

# =========================
# Supabase (obligatorio en Vercel)
# =========================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Opcional, solo si ya la tenía configurada
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Notas de seguridad:
# - AUTH_SECRET: genere uno con: openssl rand -base64 48
# - ADMIN_PASSWORD: mínimo 12 caracteres en producción
# - SUPABASE_SERVICE_ROLE_KEY: solo en el servidor / Vercel. NUNCA en el cliente.
# - En Vercel no funciona el guardado en /data; Supabase es obligatorio.
